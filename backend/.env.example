# PackSure AI Backend Configuration

# Hostinger MySQL Database Connection
# Format: mysql+pymysql://<user>:<password>@<hostinger-mysql-host>:<port>/<database_name>
# Example: mysql+pymysql://u123456789_packsure:MyStrongPassword123@sql123.main-hosting.eu:3306/u123456789_packsure_db
DATABASE_URL=sqlite:///./packsure_demo.db

# JWT & Authentication Secret
SECRET_KEY=packsure-ai-super-secret-dev-key-change-in-production

# AI / LLM API Keys (optional - leave empty for mock mode)
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# Upload storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Environment
ENV=development
DEBUG=true
